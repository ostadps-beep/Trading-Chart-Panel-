<UserControl x:Class="TradingChartPanel.WPF.Views.ChartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TradingChartPanel.WPF.Views"
             xmlns:oxy="http://oxyplot.codeplex.com/xaml/wpf"
             Background="White"
             Height="600"
             Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>  <!-- Price Axis -->
            <ColumnDefinition Width="*"/>   <!-- Chart Area -->
            <ColumnDefinition Width="20"/>  <!-- Right Margin -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>   <!-- Top Margin -->
            <RowDefinition Height="*"/>    <!-- Chart Area -->
            <RowDefinition Height="30"/>   <!-- Time Axis -->
        </Grid.RowDefinitions>

        <!-- Price Axis (Left) -->
        <local:PriceAxis Grid.Row="1" Grid.Column="0" 
                         DataContext="{Binding PriceAxisViewModel}"/>

        <!-- OxyPlot Chart Area -->
        <oxy:PlotView Grid.Row="1" Grid.Column="1"
                      Model="{Binding PlotModel}"
                      MouseDown="ChartArea_MouseDown"
                      MouseUp="ChartArea_MouseUp"
                      MouseMove="ChartArea_MouseMove"
                      MouseWheel="ChartArea_MouseWheel"
                      x:Name="ChartArea"/>

        <!-- Time Axis (Bottom) -->
        <local:TimeAxis Grid.Row="2" Grid.Column="1" 
                        DataContext="{Binding TimeAxisViewModel}"/>

        <!-- Status Bar -->
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{Binding StatusText}"
                   Foreground="#666666"
                   FontSize="11"
                   Padding="5"/>
    </Grid>
</UserControl>
